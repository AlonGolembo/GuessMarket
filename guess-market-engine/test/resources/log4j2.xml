<?xml version="1.0" encoding="UTF-8"?>
<!-- Console-only logging for the engine test run. The application ships its
     own config (javafx-ui/src/main/resources/log4j2.xml). -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss.SSS} %-5level %logger{1} - %msg%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <!-- Quiet during tests; raise to info/debug when diagnosing one. -->
        <Root level="warn">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
