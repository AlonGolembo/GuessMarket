<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="true" fitToWidth="true" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.guessmarket.ui.controllers.UsersController">
    <content>
        <!-- The vertical SplitPane fills the viewport (fitToHeight) so its
             divider can trade space between the users area and the trading
             area. The trading item's min height is its own preferred height,
             so it is never squeezed small enough to clip a control - when the
             window can't fit everything, the ScrollPane scrolls instead. -->
        <VBox minWidth="760.0" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <SplitPane fx:id="mainSplitPane" dividerPositions="0.34" orientation="VERTICAL" prefHeight="820.0" prefWidth="778.0" VBox.vgrow="ALWAYS">
                    <items>
                        <!-- Item 1: users list + selected-user details -->
                        <SplitPane dividerPositions="0.35" minHeight="180.0">
                            <items>
                                <!-- Left: Users List -->
                                <VBox minWidth="300.0" spacing="8.0">
                            <children>
                                <Label text="Users Table">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="usersTableView" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="userNameCol" prefWidth="110.0" style="-fx-alignment: CENTER;" text="User Name" />
                                        <TableColumn fx:id="userBalanceCol" prefWidth="130.0" style="-fx-alignment: CENTER;" text="Balance" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                            <padding>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                            </padding>
                        </VBox>

                        <!-- Right: Single User Details -->
                        <VBox minWidth="380.0" spacing="8.0">
                            <children>
                                <GridPane alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="130.0" />
                                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="90.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="25.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Single User Details">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label text="Account Balance:" GridPane.columnIndex="1">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="accountBalanceLabel" text="0.00" textFill="#2e7d32" GridPane.columnIndex="2">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </GridPane>

                                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="Events Participation / Owner">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TableView fx:id="userEventsTableView" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="userEventNameCol" prefWidth="130.0" text="Event Name" />
                                                <TableColumn fx:id="userEventRoleCol" prefWidth="90.0" text="Role" />
                                                <TableColumn fx:id="userEventSharesCol" prefWidth="90.0" text="Shares" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                            </padding>
                                </VBox>
                            </items>
                        </SplitPane>
                  <ScrollPane>
                     <content>
      
                                    <!-- Item 2: event details + trade panels. minHeight
                                   "-Infinity" == USE_PREF_SIZE, so the SplitPane
                                         divider can never shrink this below the height its
                                         controls actually need. -->
                              <VBox minHeight="-Infinity" spacing="10.0">
                                  <children>
                              <HBox alignment="CENTER_LEFT" spacing="12.0">
                                  <children>
                                      <Label text="Select Active Event:">
                                          <font>
                                              <Font name="System Bold" size="13.0" />
                                          </font>
                                      </Label>
                                      <ComboBox fx:id="eventsComboBox" prefWidth="280.0" promptText="Choose an active event..." />
                                  </children>
                              </HBox>
      
                                    <!-- Event details: overview + purchase history. The trade
                                   panels are no longer a column here - they sit below,
                                         replacing each other by trading method. -->
                              <GridPane fx:id="eventDetailsAndTrade" hgap="16.0" vgap="10.0">
                                  <columnConstraints>
                                      <!-- Left Column: Metadata & Metrics -->
                                      <ColumnConstraints hgrow="SOMETIMES" minWidth="260.0" prefWidth="320.0" />
                                      <!-- Right Column: Purchase History Table -->
                                      <ColumnConstraints hgrow="ALWAYS" minWidth="320.0" prefWidth="440.0" />
                                  </columnConstraints>
                                  <rowConstraints>
                                      <RowConstraints minHeight="20.0" vgrow="NEVER" />
                                      <RowConstraints minHeight="150.0" vgrow="ALWAYS" />
                                  </rowConstraints>
                                  <children>
                                      <!-- Column 1 Header: Overview -->
                                      <Label text="Event Overview &amp; Financials" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                          <font>
                                              <Font name="System Bold" size="13.0" />
                                          </font>
                                      </Label>
                                      <!-- Column 1 Content -->
                                      <VBox spacing="8.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 10;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                          <children>
                                              <HBox spacing="6.0">
                                                  <Label text="Trading Method:" textFill="#666666" />
                                                  <Label fx:id="eventMethodLabel" style="-fx-font-weight: bold;" text="-" />
                                              </HBox>
                                              <HBox spacing="6.0">
                                                  <Label text="Account Balance:" textFill="#666666" />
                                                  <Label fx:id="eventBalanceLabel" text="\$0.00" textFill="#2e7d32" />
                                              </HBox>
                                              <HBox spacing="6.0">
                                                  <Label text="Commissions Collected:" textFill="#666666" />
                                                  <Label fx:id="eventCommissionLabel" text="\$0.00" />
                                              </HBox>
                                              <HBox spacing="6.0">
                                                  <Label text="Status / Winner:" textFill="#666666" />
                                                  <Label fx:id="eventStatusOrWinningOption" text="ACTIVE" textFill="#1976d2" />
                                              </HBox>
                                              <Label text="Description:" textFill="#666666" />
                                              <Label fx:id="eventDescriptionLabel" text="-" wrapText="true" VBox.vgrow="ALWAYS" />
                                    <Button fx:id="activateEventButton" mnemonicParsing="false" onAction="#handleActivateEvent" text="Activate Event" />
                                    <HBox spacing="8.0">
                                       <children>
                                          <ComboBox fx:id="winningOptionComboBox" prefHeight="25.0" prefWidth="179.0" promptText="Choose Winning Option..." />
                                          <Button fx:id="endEventButton" mnemonicParsing="false" onAction="#handleEndEvent" prefHeight="25.0" prefWidth="91.0" text="End Event" />
                                       </children>
                                    </HBox>
                                          </children>
                                      </VBox>
      
                                            <!-- Column 2 Header: Purchase History Table -->
                                      <Label text="Purchase History" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                          <font>
                                              <Font name="System Bold" size="13.0" />
                                          </font>
                                      </Label>
                                      <!-- Column 2 Content: Purchase History TableView -->
                                      <VBox spacing="4.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 6;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                          <children>
                                              <TableView fx:id="tradeHistoryTableView" minHeight="120.0" prefHeight="170.0" VBox.vgrow="ALWAYS">
                                                  <columns>
                                                      <TableColumn fx:id="tradeDateCol" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Time" />
                                                      <TableColumn fx:id="tradeUserCol" prefWidth="66.0" style="-fx-alignment: CENTER;" text="User" />
                                                      <TableColumn fx:id="tradeOptionCol" prefWidth="86.0" style="-fx-alignment: CENTER;" text="Option" />
                                                      <TableColumn fx:id="tradeSharesCol" prefWidth="67.0" style="-fx-alignment: CENTER;" text="Shares" />
                                                      <TableColumn fx:id="tradePriceCol" prefWidth="70.0" style="-fx-alignment: CENTER;" text="Price Paid" />
                                                  </columns>
                                                  <columnResizePolicy>
                                                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                  </columnResizePolicy>
                                              </TableView>
                                          </children>
                                      </VBox>
                                  </children>
                              </GridPane>
      
                                    <!-- Trade panels: exactly one is visible at a time, bound
                                   to the selected event's trading method, so they
                                         replace each other in this slot. -->
      
                                    <!-- LMSR: buy shares priced by the market maker -->
                              <VBox fx:id="buySharesSection" managed="false" maxWidth="700.0" spacing="12.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 12;" visible="false">
                                  <children>
                                      <Label text="Buy Shares (LMSR)">
                                          <font>
                                              <Font name="System Bold" size="13.0" />
                                          </font>
                                      </Label>
                                      <VBox spacing="4.0">
                                          <children>
                                              <Label text="Option:" />
                                              <ComboBox fx:id="tradeOptionComboBox" maxWidth="1.7976931348623157E308" promptText="Select outcome..." />
                                          </children>
                                      </VBox>
      
                                            <VBox spacing="4.0">
                                          <children>
                                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                  <children>
                                                      <Label text="Price (Prob %):">
                                                          <font>
                                                              <Font name="System Bold" size="12.0" />
                                                          </font>
                                                      </Label>
                                                      <Label fx:id="optionPriceLabel" text="\$0.00">
                                                          <font>
                                                              <Font name="System Bold" size="14.0" />
                                                          </font>
                                                      </Label>
                                                  </children>
                                              </HBox>
                                              <Label text="Shares Quantity:" />
                                              <Spinner fx:id="sharesCountSpinner" editable="true" maxWidth="1.7976931348623157E308" />
                                          </children>
                                      </VBox>
      
                                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                          <children>
                                              <Label text="Commission:">
                                                  <font>
                                                      <Font name="System Bold" size="12.0" />
                                                  </font>
                                              </Label>
                                              <Label fx:id="commissionToPayLabel" text="\$0.00">
                                                  <font>
                                                      <Font name="System Bold" size="12.0" />
                                                  </font>
                                              </Label>
                                              <Label fx:id="payNowOrLaterLabel" text="(Pay now)" />
                                          </children>
                                      </HBox>
      
                                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                          <children>
                                              <Label text="Total Price:">
                                                  <font>
                                                      <Font name="System Bold" size="12.0" />
                                                  </font>
                                              </Label>
                                              <Label fx:id="totalSharesPrice" text="\$0.00" textFill="#d32f2f">
                                                  <font>
                                                      <Font name="System Bold" size="14.0" />
                                                  </font>
                                              </Label>
                                          </children>
                                      </HBox>
      
                                            <Button fx:id="executeTradeButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleExecuteTrade" style="-fx-background-color: #979797; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8;" text="Execute Purchase" />
                                  </children>
                              </VBox>
      
                                    <!-- Order Book: place limit orders against the public book -->
                              <VBox fx:id="orderEntrySection" managed="false" maxWidth="700.0" spacing="10.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 12;" visible="false">
                                  <children>
                                      <Label text="Place a Limit Order (Order Book)">
                                          <font>
                                              <Font name="System Bold" size="13.0" />
                                          </font>
                                      </Label>
                                      <HBox alignment="CENTER_LEFT" spacing="10.0">
                                          <children>
                                              <Label text="Option:" />
                                              <ComboBox fx:id="orderOptionComboBox" prefWidth="220.0" promptText="Select outcome..." />
                                          </children>
                                      </HBox>
                                      <HBox alignment="CENTER_LEFT" spacing="16.0">
                                          <children>
                                              <RadioButton fx:id="bidRadioButton" mnemonicParsing="false" selected="true" text="Buy (Bid)">
                                                  <toggleGroup>
                                                      <ToggleGroup fx:id="orderSideToggleGroup" />
                                                  </toggleGroup>
                                              </RadioButton>
                                              <RadioButton fx:id="askRadioButton" mnemonicParsing="false" text="Sell (Ask)" toggleGroup="$orderSideToggleGroup" />
                                          </children>
                                      </HBox>
                                      <HBox alignment="CENTER_LEFT" spacing="10.0">
                                          <children>
                                              <Label text="Price:" />
                                              <TextField fx:id="orderPriceField" prefWidth="90.0" promptText="0.00" />
                                              <Label text="Quantity:" />
                                              <Spinner fx:id="orderQuantitySpinner" editable="true" prefWidth="110.0" />
                                              <Button fx:id="placeOrderButton" mnemonicParsing="false" onAction="#handlePlaceOrder" text="Place Order" />
                                          </children>
                                      </HBox>
                                      <Label fx:id="orderEntryStatusLabel" style="-fx-text-fill: #666666;" text=" " wrapText="true" />
      
                                            <Label text="My Open Orders">
                                          <font>
                                              <Font name="System Bold" size="12.0" />
                                          </font>
                                      </Label>
                                      <HBox spacing="8.0">
                                          <children>
                                              <TableView fx:id="myOpenOrdersTable" minHeight="100.0" prefHeight="120.0" HBox.hgrow="ALWAYS">
                                                  <columns>
                                                      <TableColumn fx:id="myOrderOptionCol" prefWidth="90.0" text="Option" />
                                                      <TableColumn fx:id="myOrderSideCol" prefWidth="60.0" text="Side" />
                                                      <TableColumn fx:id="myOrderPriceCol" prefWidth="70.0" text="Price" />
                                                      <TableColumn fx:id="myOrderRemainingCol" prefWidth="80.0" text="Remaining" />
                                                  </columns>
                                                  <columnResizePolicy>
                                                      <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                  </columnResizePolicy>
                                              </TableView>
                                              <Button fx:id="cancelOrderButton" mnemonicParsing="false" onAction="#handleCancelOrder" text="Cancel Selected" />
                                          </children>
                                      </HBox>
                                  </children>
                              </VBox>
                                  </children>
                           <padding>
                              <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                           </padding>
                              </VBox>
                     </content>
                  </ScrollPane>
                    </items>
                </SplitPane>
            </children>
        </VBox>
    </content>
</ScrollPane>
