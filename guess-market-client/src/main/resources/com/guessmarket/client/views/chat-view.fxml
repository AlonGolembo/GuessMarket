<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="500.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.guessmarket.client.controllers.ChatController">
    <center>
        <ListView fx:id="messagesList" BorderPane.alignment="CENTER" />
    </center>
    <bottom>
        <HBox spacing="8.0" BorderPane.alignment="CENTER">
            <children>
                <TextField fx:id="messageField" onAction="#handleSend" promptText="Type a message..." HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleSend" text="Send" />
            </children>
            <padding>
                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>
