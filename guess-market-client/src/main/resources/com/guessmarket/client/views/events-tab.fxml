<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="true" fitToWidth="true" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.guessmarket.client.controllers.EventsController">
    <content>
        <VBox minWidth="760.0" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <!-- Filters -->
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label text="Filters:">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                        <ComboBox fx:id="methodFilterComboBox" prefWidth="160.0" promptText="Event Method" />
                        <ComboBox fx:id="statusFilterComboBox" prefWidth="160.0" promptText="Status (Active/Terminated)" />
                        <ComboBox fx:id="commissionFilterComboBox" prefWidth="160.0" promptText="Commission Method" />
                    </children>
                </HBox>
                <Separator />

                <!-- The vertical SplitPane fills the viewport (fitToHeight) so its
                     divider can trade space between the events area and the trading
                     area. The trading item's min height is its own preferred height,
                     so it is never squeezed small enough to clip a control - when the
                     window can't fit everything, the ScrollPane scrolls instead. -->
                <SplitPane fx:id="mainSplitPane" dividerPositions="0.55" orientation="VERTICAL" prefHeight="820.0" prefWidth="778.0" VBox.vgrow="ALWAYS">
                    <items>
                        <!-- Item 1: events list + selected-event read-only details -->
                        <SplitPane dividerPositions="0.4" minHeight="180.0">
                            <items>
                                <!-- Left: Events List -->
                                <VBox minWidth="260.0" spacing="8.0">
                                    <children>
                                        <Label text="Events List">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <TableView fx:id="eventsTableView" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="eventNameCol" prefWidth="150.0" style="-fx-alignment: CENTER;" text="Event Name" />
                                                <TableColumn fx:id="eventStatusCol" prefWidth="99.0" style="-fx-alignment: CENTER;" text="Status" />
                                                <TableColumn fx:id="eventMethodCol" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Event Method" />
                                                <TableColumn fx:id="commissionMethodCol" prefWidth="90.0" style="-fx-alignment: CENTER;" text="Commission Method" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                    <padding>
                                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                    </padding>
                                </VBox>

                                <!-- Right: read-only event details, order books & participations -->
                                <TabPane tabClosingPolicy="UNAVAILABLE">
                                    <tabs>
                                        <Tab text="Trade">
                                            <content>
                                                <VBox fx:id="eventTradeDetailsContainer" minWidth="380.0" spacing="10.0">
                                                    <padding>
                                                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                                    </padding>
                                                    <children>
                                                        <Label text="Event Details &amp; Trade">
                                                            <font>
                                                                <Font name="System Bold" size="14.0" />
                                                            </font>
                                                        </Label>

                                                        <!-- Closed-event summary: winner + total shares bought per option -->
                                                        <Label fx:id="closedSummaryLabel" managed="false" style="-fx-text-fill: #1b5e20; -fx-font-weight: bold;" visible="false" wrapText="true" />

                                                        <!-- Side by Side Order Books (Order Book events only; empty/hidden for LMSR) -->
                                                        <VBox fx:id="orderBookSection" spacing="6.0">
                                                            <children>
                                                                <HBox spacing="10.0">
                                                                    <children>
                                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                                            <children>
                                                                                <Label fx:id="option1BookLabel" text="Option 1 Order Book" />
                                                                                <TableView fx:id="option1OrderBookTable" minHeight="120.0" prefHeight="130.0">
                                                                                    <columns>
                                                                                        <TableColumn fx:id="opt1SideCol" prefWidth="55.0" text="Side" />
                                                                                        <TableColumn fx:id="opt1PriceCol" prefWidth="75.0" text="Price" />
                                                                                        <TableColumn fx:id="opt1AmountCol" prefWidth="75.0" text="Amount" />
                                                                                    </columns>
                                                                                    <columnResizePolicy>
                                                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                                                    </columnResizePolicy>
                                                                                </TableView>
                                                                                <Label fx:id="option1IndicatorsLabel" style="-fx-font-size: 11px; -fx-text-fill: #666666;" text="Last: - | Bid: - | Ask: - | Mid: - | Spread: -" wrapText="true" />
                                                                            </children>
                                                                        </VBox>
                                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                                            <children>
                                                                                <Label fx:id="option2BookLabel" text="Option 2 Order Book" />
                                                                                <TableView fx:id="option2OrderBookTable" minHeight="120.0" prefHeight="130.0">
                                                                                    <columns>
                                                                                        <TableColumn fx:id="opt2SideCol" prefWidth="55.0" text="Side" />
                                                                                        <TableColumn fx:id="opt2PriceCol" prefWidth="75.0" text="Price" />
                                                                                        <TableColumn fx:id="opt2AmountCol" prefWidth="75.0" text="Amount" />
                                                                                    </columns>
                                                                                    <columnResizePolicy>
                                                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                                                    </columnResizePolicy>
                                                                                </TableView>
                                                                                <Label fx:id="option2IndicatorsLabel" style="-fx-font-size: 11px; -fx-text-fill: #666666;" text="Last: - | Bid: - | Ask: - | Mid: - | Spread: -" wrapText="true" />
                                                                            </children>
                                                                        </VBox>
                                                                    </children>
                                                                </HBox>
                                                            </children>
                                                        </VBox>

                                                        <!-- Participations Table -->
                                                        <VBox spacing="4.0" VBox.vgrow="ALWAYS">
                                                            <children>
                                                                <Label text="Participations Information">
                                                                    <font>
                                                                        <Font name="System Bold" size="12.0" />
                                                                    </font>
                                                                </Label>
                                                                <TableView fx:id="participationsTableView" minHeight="120.0" prefHeight="140.0" VBox.vgrow="ALWAYS">
                                                                    <columns>
                                                                        <TableColumn fx:id="partUserCol" prefWidth="110.0" style="-fx-alignment: CENTER;" text="User" />
                                                                        <TableColumn fx:id="partOptionCol" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Option" />
                                                                        <TableColumn fx:id="partSharesCol" prefWidth="100.0" style="-fx-alignment: CENTER;" text="Shares" />
                                                                    </columns>
                                                                    <columnResizePolicy>
                                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                                    </columnResizePolicy>
                                                                </TableView>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </Tab>
                                        <Tab text="Graphs">
                                            <content>
                                                <!-- One price-over-time chart per option; filled in by EventsController on selection -->
                                                <HBox minWidth="380.0" spacing="10.0">
                                                    <padding>
                                                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                                    </padding>
                                                    <children>
                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label fx:id="leftGraphLabel" text="Option 1 Price">
                                                                    <font>
                                                                        <Font name="System Bold" size="12.0" />
                                                                    </font>
                                                                </Label>
                                                                <AnchorPane fx:id="leftGraph" minHeight="200.0" VBox.vgrow="ALWAYS" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label fx:id="rightGraphLabel" text="Option 2 Price">
                                                                    <font>
                                                                        <Font name="System Bold" size="12.0" />
                                                                    </font>
                                                                </Label>
                                                                <AnchorPane fx:id="rightGraph" minHeight="200.0" VBox.vgrow="ALWAYS" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>
                                            </content>
                                        </Tab>
                                    </tabs>
                                </TabPane>
                            </items>
                        </SplitPane>

                        <!-- Item 2: financials, market-maker control, purchase history & trade entry.
                             minHeight "-Infinity" == USE_PREF_SIZE, so the SplitPane divider can
                             never shrink this below the height its controls actually need. -->
                        <ScrollPane fitToWidth="true">
                            <content>
                                <VBox minHeight="-Infinity" spacing="10.0">
                                    <padding>
                                        <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                                    </padding>
                                    <children>
                                        <!-- Financials & MM control: activate/close are only enabled
                                             when I am this event's market maker (enforced by the engine
                                             regardless; this just keeps the buttons honest). -->
                                        <VBox spacing="8.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 10;">
                                            <children>
                                                <Label text="Financials &amp; Control">
                                                    <font>
                                                        <Font name="System Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                                <HBox spacing="6.0">
                                                    <children>
                                                        <Label text="Account Balance:" textFill="#666666" />
                                                        <Label fx:id="eventBalanceLabel" text="\$0.00" textFill="#2e7d32" />
                                                    </children>
                                                </HBox>
                                                <HBox spacing="6.0">
                                                    <children>
                                                        <Label text="Commissions Collected:" textFill="#666666" />
                                                        <Label fx:id="eventCommissionLabel" text="\$0.00" />
                                                    </children>
                                                </HBox>
                                                <Label text="Description:" textFill="#666666" />
                                                <Label fx:id="eventDescriptionLabel" text="-" wrapText="true" />
                                                <Button fx:id="activateEventButton" maxWidth="-Infinity" mnemonicParsing="false" onAction="#handleActivateEvent" text="Activate Event (as Market Maker)" />
                                                <HBox spacing="8.0">
                                                    <children>
                                                        <ComboBox fx:id="winningOptionComboBox" prefHeight="25.0" prefWidth="191.0" promptText="Choose Winning Option..." />
                                                        <Button fx:id="endEventButton" mnemonicParsing="false" onAction="#handleEndEvent" text="End Event" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>

                                        <!-- Purchase History -->
                                        <VBox spacing="4.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 6;">
                                            <children>
                                                <Label text="Purchase History">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <TableView fx:id="tradeHistoryTableView" minHeight="120.0" prefHeight="160.0">
                                                    <columns>
                                                        <TableColumn fx:id="tradeDateCol" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Time" />
                                                        <TableColumn fx:id="tradeUserCol" prefWidth="66.0" style="-fx-alignment: CENTER;" text="User" />
                                                        <TableColumn fx:id="tradeOptionCol" prefWidth="86.0" style="-fx-alignment: CENTER;" text="Option" />
                                                        <TableColumn fx:id="tradeSharesCol" prefWidth="67.0" style="-fx-alignment: CENTER;" text="Shares" />
                                                        <TableColumn fx:id="tradePriceCol" prefWidth="70.0" style="-fx-alignment: CENTER;" text="Price Paid" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                        </VBox>

                                        <!-- LMSR: buy shares priced by the market maker -->
                                        <VBox fx:id="buySharesSection" managed="false" maxWidth="700.0" spacing="12.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 12;" visible="false">
                                            <children>
                                                <Label text="Buy Shares (LMSR)">
                                                    <font>
                                                        <Font name="System Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <Label text="Option:" />
                                                        <ComboBox fx:id="tradeOptionComboBox" maxWidth="1.7976931348623157E308" promptText="Select outcome..." />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="4.0">
                                                    <children>
                                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                            <children>
                                                                <Label text="Price (Prob %):">
                                                                    <font>
                                                                        <Font name="System Bold" size="12.0" />
                                                                    </font>
                                                                </Label>
                                                                <Label fx:id="optionPriceLabel" text="\$0.00">
                                                                    <font>
                                                                        <Font name="System Bold" size="14.0" />
                                                                    </font>
                                                                </Label>
                                                            </children>
                                                        </HBox>
                                                        <Label text="Shares Quantity:" />
                                                        <Spinner fx:id="sharesCountSpinner" editable="true" maxWidth="1.7976931348623157E308" />
                                                    </children>
                                                </VBox>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label text="Commission:">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <Label fx:id="commissionToPayLabel" text="\$0.00">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <Label fx:id="payNowOrLaterLabel" text="(Pay now)" />
                                                    </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label text="Total Price:">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <Label fx:id="totalSharesPrice" text="\$0.00" textFill="#d32f2f">
                                                            <font>
                                                                <Font name="System Bold" size="14.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </HBox>
                                                <Button fx:id="executeTradeButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleExecuteTrade" style="-fx-background-color: #979797; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8;" text="Execute Purchase" />
                                            </children>
                                        </VBox>

                                        <!-- Order Book: place limit orders against the public book -->
                                        <VBox fx:id="orderEntrySection" managed="false" maxWidth="700.0" spacing="10.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 12;" visible="false">
                                            <children>
                                                <Label text="Place a Limit Order (Order Book)">
                                                    <font>
                                                        <Font name="System Bold" size="13.0" />
                                                    </font>
                                                </Label>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label text="Option:" />
                                                        <ComboBox fx:id="orderOptionComboBox" prefWidth="220.0" promptText="Select outcome..." />
                                                    </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="16.0">
                                                    <children>
                                                        <RadioButton fx:id="bidRadioButton" mnemonicParsing="false" selected="true" text="Buy (Bid)">
                                                            <toggleGroup>
                                                                <ToggleGroup fx:id="orderSideToggleGroup" />
                                                            </toggleGroup>
                                                        </RadioButton>
                                                        <RadioButton fx:id="askRadioButton" mnemonicParsing="false" text="Sell (Ask)" toggleGroup="$orderSideToggleGroup" />
                                                    </children>
                                                </HBox>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label text="Price:" />
                                                        <TextField fx:id="orderPriceField" prefWidth="90.0" promptText="0.00" />
                                                        <Label text="Quantity:" />
                                                        <Spinner fx:id="orderQuantitySpinner" editable="true" prefWidth="110.0" />
                                                        <Button fx:id="placeOrderButton" mnemonicParsing="false" onAction="#handlePlaceOrder" text="Place Order" />
                                                    </children>
                                                </HBox>
                                                <Label fx:id="orderEntryStatusLabel" style="-fx-text-fill: #666666;" text=" " wrapText="true" />
                                                <Label text="My Open Orders">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <HBox spacing="8.0">
                                                    <children>
                                                        <TableView fx:id="myOpenOrdersTable" minHeight="100.0" prefHeight="120.0" HBox.hgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn fx:id="myOrderOptionCol" prefWidth="90.0" text="Option" />
                                                                <TableColumn fx:id="myOrderSideCol" prefWidth="60.0" text="Side" />
                                                                <TableColumn fx:id="myOrderPriceCol" prefWidth="70.0" text="Price" />
                                                                <TableColumn fx:id="myOrderRemainingCol" prefWidth="80.0" text="Remaining" />
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                            </columnResizePolicy>
                                                        </TableView>
                                                        <Button fx:id="cancelOrderButton" mnemonicParsing="false" onAction="#handleCancelOrder" text="Cancel Selected" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </items>
                </SplitPane>
            </children>
        </VBox>
    </content>
</ScrollPane>
