<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="true" fitToWidth="true" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.guessmarket.ui.controllers.UsersController">
    <content>
        <VBox spacing="8.0">
            <children>
                <SplitPane dividerPositions="0.35" VBox.vgrow="ALWAYS">
                    <items>
                        <!-- Left: Users List -->
                        <VBox minWidth="260.0" spacing="8.0">
                            <children>
                                <Label text="Users Table">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="usersTableView" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="userNameCol" prefWidth="111.0" text="User Name" />
                                        <TableColumn fx:id="userBalanceCol" prefWidth="131.0" text="Balance" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                            <padding>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                            </padding>
                        </VBox>

                        <!-- Right: Single User Details -->
                        <VBox minWidth="380.0" spacing="14.0">
                            <children>
                                <Label text="Single User Details">
                                    <font>
                                        <Font name="System Bold" size="15.0" />
                                    </font>
                                </Label>

                                <!-- Balance Card -->
                                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #dddddd; -fx-padding: 10; -fx-background-color: #fcfcfc;">
                                    <children>
                                        <Label text="Account Balance:">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="accountBalanceLabel" text="0.00" textFill="#2e7d32">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>

                                <!-- Events Participated / Owned -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Events Participation / Owner">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TableView fx:id="userEventsTableView" prefHeight="160.0">
                                            <columns>
                                                <TableColumn fx:id="userEventNameCol" prefWidth="130.0" text="Event Name" />
                                                <TableColumn fx:id="userEventRoleCol" prefWidth="90.0" text="Role" />
                                                <TableColumn fx:id="userEventSharesCol" prefWidth="90.0" text="Shares" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                                <!-- Single Event Details Container -->
                                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="Single Event Details and Trade">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <VBox fx:id="singleEventTradeDetailsContainer" minHeight="120.0" style="-fx-border-color: #cccccc; -fx-padding: 8; -fx-background-color: #fafafa;" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>
                    </items>
                </SplitPane>
            </children>
        </VBox>
    </content>
</ScrollPane>
