<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToHeight="true" fitToWidth="true" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.guessmarket.ui.controllers.UsersController">
    <content>
        <VBox spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
                <!-- Top Section: Users Table & User Details -->
                <SplitPane dividerPositions="0.35" VBox.vgrow="ALWAYS">
                    <items>
                        <!-- Left: Users List -->
                        <VBox spacing="8.0">
                            <children>
                                <Label text="Users Table">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="usersTableView" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="userNameCol" prefWidth="110.0" style="-fx-alignment: CENTER;" text="User Name" />
                                        <TableColumn fx:id="userBalanceCol" prefWidth="130.0" style="-fx-alignment: CENTER;" text="Balance" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                            <padding>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                            </padding>
                        </VBox>

                        <!-- Right: Single User Details -->
                        <VBox minWidth="380.0" spacing="12.0">
                            <children>
                                <GridPane alignment="CENTER">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" minWidth="150.0" />
                                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="130.0" />
                                        <ColumnConstraints halignment="RIGHT" hgrow="NEVER" minWidth="90.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="25.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label text="Single User Details">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Label text="Account Balance:" GridPane.columnIndex="1">
                                            <font>
                                                <Font name="System Bold" size="13.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="accountBalanceLabel" text="0.00" textFill="#2e7d32" GridPane.columnIndex="2">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </GridPane>

                                <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="Events Participation / Owner">
                                            <font>
                                                <Font name="System Bold" size="12.0" />
                                            </font>
                                        </Label>
                                        <TableView fx:id="userEventsTableView" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="userEventNameCol" prefWidth="130.0" text="Event Name" />
                                                <TableColumn fx:id="userEventRoleCol" prefWidth="90.0" text="Role" />
                                                <TableColumn fx:id="userEventSharesCol" prefWidth="90.0" text="Shares" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                            <padding>
                                <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
                            </padding>
                        </VBox>
                    </items>
                </SplitPane>

                <Separator />

                <!-- Bottom Section: Event Details & Trade Action -->
                <VBox spacing="10.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label text="Select Active Event:">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <ComboBox fx:id="eventsComboBox" prefWidth="280.0" promptText="Choose an active event..." />
                            </children>
                        </HBox>

                        <!-- Trade & Details Grid -->
                        <GridPane fx:id="eventDetailsAndTrade" hgap="16.0" vgap="10.0">
                            <columnConstraints>
                                <!-- Left Column: Metadata & Metrics -->
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="280.0" prefWidth="300.0" />
                                <!-- Middle Column: Purchase History Table -->
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="320.0" prefWidth="380.0" />
                                <!-- Right Column: Trade Action Panel -->
                                <ColumnConstraints hgrow="SOMETIMES" minWidth="280.0" prefWidth="300.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="20.0" vgrow="NEVER" />
                                <RowConstraints minHeight="200.0" vgrow="ALWAYS" />
                            </rowConstraints>
                            <children>
                                <!-- Column 1 Header: Overview -->
                                <Label text="Event Overview &amp; Financials" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <!-- Column 1 Content -->
                                <VBox spacing="8.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 10;" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <children>
                                        <HBox spacing="6.0">
                                            <Label text="Trading Method:" textFill="#666666" />
                                            <Label fx:id="eventMethodLabel" style="-fx-font-weight: bold;" text="-" />
                                        </HBox>
                                        <HBox spacing="6.0">
                                            <Label text="Account Balance:" textFill="#666666" />
                                            <Label fx:id="eventBalanceLabel" text="\$0.00" textFill="#2e7d32" />
                                        </HBox>
                                        <HBox spacing="6.0">
                                            <Label text="Commissions Collected:" textFill="#666666" />
                                            <Label fx:id="eventCommissionLabel" text="\$0.00" />
                                        </HBox>
                                        <HBox spacing="6.0">
                                            <Label text="Status / Winner:" textFill="#666666" />
                                            <Label fx:id="eventStatusOrWinningOption" text="ACTIVE" textFill="#1976d2" />
                                        </HBox>
                                        <Label text="Description:" textFill="#666666" />
                                        <Label fx:id="eventDescriptionLabel" text="-" wrapText="true" VBox.vgrow="ALWAYS" />
                              <Button fx:id="activateEventButton" mnemonicParsing="false" onAction="#handleActivateEvent" text="Activate Event" />
                                    </children>
                                </VBox>

                                <!-- Column 2 Header: Purchase History Table -->
                                <Label text="Purchase History" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <!-- Column 2 Content: Purchase History TableView -->
                                <VBox spacing="4.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 6;" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <children>
                                        <TableView fx:id="tradeHistoryTableView" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="tradeDateCol" prefWidth="75.0" style="-fx-alignment: CENTER;" text="Time" />
                                                <TableColumn fx:id="tradeUserCol" prefWidth="66.0" style="-fx-alignment: CENTER;" text="User" />
                                                <TableColumn fx:id="tradeOptionCol" prefWidth="86.0" style="-fx-alignment: CENTER;" text="Option" />
                                                <TableColumn fx:id="tradeSharesCol" prefWidth="67.0" style="-fx-alignment: CENTER;" text="Shares" />
                                                <TableColumn fx:id="tradePriceCol" prefWidth="70.0" style="-fx-alignment: CENTER;" text="Price Paid" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                                <!-- Column 3 Header: Trade Terminal -->
                                <Label text="Buy Shares" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <!-- Column 3 Content: Action Box -->
                                <VBox fx:id="buySharesSection" spacing="12.0" style="-fx-border-color: #dcdcdc; -fx-border-radius: 4; -fx-padding: 12;" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                    <children>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label text="Option:" />
                                                <ComboBox fx:id="tradeOptionComboBox" maxWidth="1.7976931348623157E308" promptText="Select outcome..." />
                                            </children>
                                        </VBox>

                                        <VBox spacing="4.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label text="Price (Prob %):">
                                                            <font>
                                                                <Font name="System Bold" size="12.0" />
                                                            </font>
                                                        </Label>
                                                        <Label fx:id="optionPriceLabel" text="\$0.00">
                                                            <font>
                                                                <Font name="System Bold" size="14.0" />
                                                            </font>
                                                        </Label>
                                                    </children>
                                                </HBox>
                                                <Label text="Shares Quantity:" />
                                                <!-- Spinner with numeric up/down arrows -->
                                                <Spinner fx:id="sharesCountSpinner" editable="true" maxWidth="1.7976931348623157E308" />
                                            </children>
                                        </VBox>
                              <HBox alignment="CENTER_LEFT" spacing="8.0">
                                 <children>
                                    <Label text="Commission:">
                                       <font>
                                          <Font name="System Bold" size="12.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="commissionToPayLabel" text="\$0.00">
                                       <font>
                                          <Font name="System Bold" size="12.0" />
                                       </font>
                                    </Label>
                                    <Label fx:id="payNowOrLaterLabel" text="(Pay now)" />
                                 </children>
                              </HBox>

                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label text="Total Price:">
                                                    <font>
                                                        <Font name="System Bold" size="12.0" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="totalSharesPrice" text="\$0.00" textFill="#d32f2f">
                                                    <font>
                                                        <Font name="System Bold" size="14.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </HBox>

                                        <Button fx:id="executeTradeButton" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleExecuteTrade" style="-fx-background-color: #979797; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8;" text="Execute Purchase" />
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </content>
</ScrollPane>
